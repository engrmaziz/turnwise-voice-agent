# Copy to .env for local overrides. Empty TURNWISE_PII_HASH_KEY means the
# process generates a key at startup; hashes then differ across restarts.
TURNWISE_SERVICE_NAME=turnwise
TURNWISE_LOG_LEVEL=INFO
TURNWISE_LOG_JSON=false
TURNWISE_HTTP_HOST=127.0.0.1
TURNWISE_HTTP_PORT=8000
# Compose host publishes only. Container ports stay 8000 / 9090 / 4317.
TURNWISE_HOST_HTTP_PORT=8010
TURNWISE_HOST_PROM_PORT=9080
TURNWISE_HOST_OTLP_PORT=4217
TURNWISE_STAGE_QUEUE_MAXSIZE=32
TURNWISE_STAGE_PUT_TIMEOUT_S=0.25
TURNWISE_OTEL_ENABLED=true
TURNWISE_OTEL_ENDPOINT=http://localhost:4317
TURNWISE_OTEL_INSECURE=true
TURNWISE_OTEL_EXPORT_TIMEOUT_S=5
TURNWISE_OTEL_MAX_QUEUE_SIZE=2048
TURNWISE_METRICS_ENABLED=true
TURNWISE_PII_HASH_KEY=
TURNWISE_PII_FIELDS=patient_name,name,dob,date_of_birth,phone
TURNWISE_WS_PATH=/v1/audio
TURNWISE_WS_SAMPLE_RATE_HZ=16000
TURNWISE_WS_FRAME_MS=20
TURNWISE_WS_MAX_SESSIONS=8
TURNWISE_BENCH_WARMUP=5
TURNWISE_BENCH_SAMPLES=20
TURNWISE_BENCH_TIMEOUT_S=30
TURNWISE_BENCH_RESULTS_DIR=docs/results/bench
TURNWISE_BENCH_MARKDOWN_PATH=docs/benchmarks.md
TURNWISE_BENCH_ADR_PATH=docs/adr/ADR-004-hardware-tier.md
TURNWISE_BENCH_SHERPA_MODEL_DIR=
TURNWISE_BENCH_WHISPER_MODEL=
TURNWISE_BENCH_LLM_COMMAND=
TURNWISE_BENCH_TTS_COMMAND=
TURNWISE_WS_ALLOWED_SAMPLE_RATES=8000,16000,48000
TURNWISE_VAD_WINDOW_SAMPLES=512
TURNWISE_VAD_SPEECH_THRESHOLD=0.5
TURNWISE_VAD_SPEECH_START_MS=200
TURNWISE_VAD_PREROLL_MS=500
TURNWISE_VAD_MAX_UTTERANCE_MS=15000
TURNWISE_VAD_TIMEOUT_MS=30
TURNWISE_VAD_ONNX_PATH=models/weights/silero_vad.onnx
TURNWISE_AUDIO_SILENCE_RMS=0.005
TURNWISE_AUDIO_SILENCE_WINDOW_S=3.0
TURNWISE_AUDIO_CLIP_FRACTION=0.01
TURNWISE_AUDIO_CLIP_PEAK=32760
TURNWISE_HEADPHONES_PCM_PATH=client/prompts/headphones.pcm
# Empty keeps the ASR stub (CI). ADR-006 picks zipformer (compare finalize p50 173.7 ms,
# TARGET 100 ms missed). After `uv sync --extra asr` and `python scripts/download_models.py`,
# set TURNWISE_ASR_BACKEND=zipformer.
TURNWISE_ASR_BACKEND=
TURNWISE_ASR_ZIPFORMER_ENCODER_PATH=models/weights/zipformer/encoder-epoch-99-avg-1-chunk-16-left-128.int8.onnx
TURNWISE_ASR_ZIPFORMER_DECODER_PATH=models/weights/zipformer/decoder-epoch-99-avg-1-chunk-16-left-128.int8.onnx
TURNWISE_ASR_ZIPFORMER_JOINER_PATH=models/weights/zipformer/joiner-epoch-99-avg-1-chunk-16-left-128.int8.onnx
TURNWISE_ASR_ZIPFORMER_TOKENS_PATH=models/weights/zipformer/tokens.txt
TURNWISE_ASR_ZIPFORMER_BPE_VOCAB_PATH=models/weights/zipformer/bpe.vocab
TURNWISE_ASR_ZIPFORMER_BPE_MODEL_PATH=models/weights/zipformer/bpe.model
TURNWISE_ASR_WHISPER_MODEL_PATH=models/weights/whisper/tiny.en
TURNWISE_ASR_POOL_SLOTS=1
TURNWISE_ASR_FINISH_TIMEOUT_MS=200
TURNWISE_ASR_STUB_TRANSCRIPT=book tuesday at two thirty
TURNWISE_HOTWORD_SCORE=2.0
TURNWISE_CLINIC_TIMEZONE=America/New_York
TURNWISE_CLINIC_NAME=Turnwise Clinic
TURNWISE_DOCTOR_ROSTER_PATH=data/doctors.txt
TURNWISE_ITN_TIMEOUT_S=0.5
TURNWISE_ENDPOINT_DIGIT_PATIENCE_MS=1000
TURNWISE_ENDPOINT_DIGIT_HARD_MS=2000
TURNWISE_ENDPOINT_HARD_SILENCE_MS=1200
TURNWISE_ENDPOINT_HIGH_P=0.85
TURNWISE_ENDPOINT_HIGH_SILENCE_MS=200
TURNWISE_ENDPOINT_MID_P=0.5
TURNWISE_ENDPOINT_MID_SILENCE_MS=500
TURNWISE_ENDPOINT_DEFAULT_SILENCE_MS=800
TURNWISE_TURN_MODEL_ENABLED=true
TURNWISE_TURN_TIMEOUT_MS=20
TURNWISE_TURN_ONNX_PATH=models/weights/turn_complete.onnx
TURNWISE_TURN_FEATURE_DIM=256
TURNWISE_TURN_NGRAM=3
TURNWISE_BARGE_IN_MIN_SPEECH_MS=250
TURNWISE_BACKCHANNEL_MAX_MS=400
TURNWISE_BACKCHANNEL_PHRASES=mm-hmm,mhm,uh-huh,yeah,ok,okay
TURNWISE_NLU_MODEL_PATH=
TURNWISE_NLU_TIMEOUT_MS=40
TURNWISE_NLU_MIN_INTENT_CONFIDENCE=0.6
TURNWISE_NLU_FEATURE_DIM=256
TURNWISE_NLU_NGRAM=3
TURNWISE_PHONETIC_MIN_SCORE=0.75
TURNWISE_PHONETIC_MARGIN=0.03
TURNWISE_REPAIR_MARKERS=no,sorry,i mean,actually
TURNWISE_REPAIR_MODALITY_AFTER=2
TURNWISE_REPAIR_HANDOFF_AFTER=3
TURNWISE_TOOL_FILLER_AFTER_MS=300
TURNWISE_TOOL_HARD_TIMEOUT_MS=1500
TURNWISE_TOOL_RETRY_LIMIT=1
TURNWISE_CONFIRM_EXPLICIT_BELOW=0.8
TURNWISE_URGENT_KEYWORDS=chest pain,can't breathe,cannot breathe,cant breathe,shortness of breath,passing out,fainted,stroke,suicidal
TURNWISE_REGEX_SLOTS_ENABLED=false
TURNWISE_PARAPHRASE_MAX_CHARS=180
TURNWISE_FAQ_MIN_SCORE=0.2
TURNWISE_FAQ_PATH=data/faq.md
TURNWISE_CALENDAR_DB_PATH=data/turnwise.sqlite
TURNWISE_LLM_TIMEOUT_MS=2000
# Empty keeps the silence stub (CI). Piper: uv sync --extra tts && python scripts/download_models.py
# then TURNWISE_TTS_BACKEND=piper. Default stays empty so a missing voice is not required.
TURNWISE_TTS_BACKEND=
TURNWISE_TTS_PIPER_ONNX_PATH=models/weights/piper/en_US-amy-low.onnx
TURNWISE_TTS_PIPER_CONFIG_PATH=models/weights/piper/en_US-amy-low.onnx.json
TURNWISE_TTS_VOICE=default
TURNWISE_TTS_SPEED=1.0
TURNWISE_TTS_DIGIT_SPEED=0.85
TURNWISE_TTS_FRAME_MS=20
TURNWISE_TTS_FIRST_CHUNK_MIN_WORDS=4
TURNWISE_TTS_LATER_MIN_WORDS=8
TURNWISE_TTS_MAX_HOLD_MS=400
TURNWISE_TTS_TIMEOUT_MS=800
TURNWISE_TTS_ABBREV=dr.,mr.,mrs.,ms.,st.,e.g.,i.e.,p.m.,a.m.
TURNWISE_TTS_WARMUP_PHRASES=greeting,one_moment,could_you_repeat,headphones_required,seek_emergency,cannot_book_now,cannot_speak,goodbye
TURNWISE_EMOTION_MODEL_PATH=
TURNWISE_EMOTION_MODEL_ENABLED=false
TURNWISE_EMOTION_TIMEOUT_MS=80
TURNWISE_SENTIMENT_ENABLED=true
TURNWISE_SENTIMENT_MODEL_ENABLED=false
TURNWISE_FRUSTRATION_THRESHOLD=0.65
TURNWISE_FRUSTRATION_TURNS=2
TURNWISE_TTS_FRUSTRATED_SPEED=0.9
TURNWISE_FUSE_W_AUDIO=0.4
TURNWISE_FUSE_W_TEXT=0.2
TURNWISE_FUSE_W_REPAIR=0.2
TURNWISE_FUSE_W_NO=0.1
TURNWISE_FUSE_W_BARGE=0.1
# Eval process. TURNWISE_EVAL_TEXT_INJECT must stay false in production.
TURNWISE_EVAL_SCENARIO_DIR=evals/scenarios
TURNWISE_EVAL_TIME_SCALE=0
TURNWISE_EVAL_REALTIME_N=30
TURNWISE_EVAL_SMOKE_N=30
TURNWISE_EVAL_MATRIX_N=900
TURNWISE_EVAL_SOFT_JUDGE=false
TURNWISE_EVAL_TEXT_INJECT=false
TURNWISE_LLM_HEALTH_TIMEOUT_MS=2000
# Empty keeps LlmClient.unavailable (CI). After a local Ollama model exists,
# set TURNWISE_LLM_BACKEND=ollama. JSON schema is passed as Ollama `format`.
TURNWISE_LLM_BACKEND=
TURNWISE_LLM_OLLAMA_HOST=http://127.0.0.1:11434
TURNWISE_LLM_OLLAMA_MODEL=qwen3.5:4b
TURNWISE_ASR_COLLAPSE_TURNS=3
TURNWISE_ASR_COLLAPSE_CONF=0.3
# Compose must not flip this on for a demo recording.
TURNWISE_AUDIO_RETAIN=false
TURNWISE_AUDIO_RETAIN_S=0
TURNWISE_AUDIO_RETAIN_DIR=data/retain
TURNWISE_LOAD_N_MAX=16
TURNWISE_LLM_MAX_BATCH=1
